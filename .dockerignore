# Dev tooling / agent caches — never used by the Docker build (frontend/ and
# backend/ are the only paths COPYed). Excluding these cuts the build context
# from ~524 MB to well under 50 MB, so every deploy uploads far less.
.claude
.aider*
.serena
.codex
.agents
.obsidian
design-mockups
frontend/dist
**/node_modules
.pytest_cache
.ruff_cache
.mypy_cache
.DS_Store
.vscode
.idea

# data/ holds multi-GB WRDS/LSEG source CSV exports + runtime caches; only the
# compact, already-ingested serving stores are COPYed into the image.
data/*
!data/veridion_nodes.db
!data/port_performance.db
!data/renthub_snapshot.db
!data/consumer_spend.db
!data/supply_chain.db
!data/corporate.db
!data/crsp.db
