      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/willneedlman/finance_dashboard/.codex/hooks/frontend_typecheck.py'",
            "timeout": 130
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \".agents/skills/impeccable/scripts/hook.mjs\" ] || node \".agents/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
